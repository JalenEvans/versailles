{
	"name": "versailles-dbc",
	"version": "0.1.0",
	"description": "Deterministic test generation from Design-by-Contract specifications",
	"private": false,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"bin": {
		"versailles": "./bin/versailles"
	},
	"files": ["dist", "bin", "config.schema.json"],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"smoke": "vitest run tests/smoke.test.ts",
		"lint": "biome check .",
		"check": "biome check ."
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^26.2.0",
		"ajv": "^8.17.0",
		"fast-check": "^4.9.0",
		"typescript": "^5.8.0",
		"vitest": "^3.0.0"
	},
	"engines": {
		"node": ">=20"
	}
}
