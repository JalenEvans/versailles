#!/usr/bin/env node
// versailles — CLI entry (build-spec §10, §12). Wires the machine-readable
// surface from packages/cli/src/cli/index.ts: prints the stable JSON envelope
// on stdout and exits with the computed exit code (0 clean · 1
// parse/validation/usage · 2 blocking staleness). No LLM is ever invoked
// (ADR-0010).
//
// Top-level try/catch (VERSAILLES-188): if runCli escapes with an unhandled
// throw, the shim catches it and prints the standardized failure envelope
// { ok: false, errors: [{ code: "INTERNAL", ... }], warnings: [], exitCode: 1 }
// so the contract surface is preserved — never an unstructured crash.
import { runCli } from "../dist/packages/cli/src/cli/index.js";

try {
	const result = await runCli(process.argv.slice(2), { cwd: process.cwd() });
	process.stdout.write(`${JSON.stringify(result)}\n`);
	process.exit(result.exitCode);
} catch (error) {
	const detail = error instanceof Error ? error.message : String(error);
	process.stdout.write(
		`${JSON.stringify({ ok: false, errors: [{ code: "INTERNAL", detail }], warnings: [], exitCode: 1 })}\n`,
	);
	process.exit(1);
}